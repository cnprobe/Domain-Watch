# HTTP
PORT=3000
HOST=0.0.0.0
TZ=Asia/Shanghai

# Persistent data (use ./data locally; Docker Compose overrides this to /app/data)
DATA_DIR=./data

# Single-user authentication
ADMIN_USERNAME=admin
SESSION_TTL_DAYS=7
# Set true when the site is behind an HTTPS reverse proxy.
COOKIE_SECURE=false
# The whole site requires login by default. Set true only if you want the
# query page and /api/whois to be reachable without logging in.
PUBLIC_QUERY=false
# Set true for one restart to generate and print a new random password.
RESET_ADMIN_PASSWORD=false

# Brute-force protection for POST /api/auth/login. Two layers are enforced at
# the same time: per source IP and per account, so rotating IPs does not help.
# Counters live in memory only and reset when the container restarts.
LOGIN_IP_MAX_FAILURES=5
LOGIN_IP_WINDOW_MINUTES=15
# The account layer is what stops a distributed dictionary attack; keep its
# window clearly longer than the IP one.
LOGIN_ACCOUNT_MAX_FAILURES=10
LOGIN_ACCOUNT_WINDOW_MINUTES=30
# Set true ONLY when the service really sits behind a reverse proxy you
# control. While it is false the X-Forwarded-For header is ignored, otherwise
# anyone could spoof it and walk around the per-IP limit.
TRUST_PROXY=false
# Optional: use a Docker secret instead of the generated data/config.key file.
CONFIG_ENCRYPTION_KEY=

# Comma-separated domains to monitor, for example: example.com,example.org
DOMAINS=
REMIND_DAYS=30
DAILY_REMIND=true
BACKORDER_NOTIFY=true
# Local server time in HH:mm format. The container timezone is controlled by TZ.
CHECK_TIME=09:00
# Set true to check once when the container starts.
RUN_ON_STARTUP=false

# Initial Telegram Bot API values. After the first start, they are migrated to
# the encrypted settings store and can be managed from /settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: use a local Bot API server instead of api.telegram.org.
TELEGRAM_API_BASE=https://api.telegram.org

# Deprecated optional API fallback. Prefer the single-user login session.
ADMIN_TOKEN=

# Optional: JSON file that overrides which RDAP server is used for a TLD.
# Format: { "tlds": { "cn": ["https://rdap.example.cn/"], "jp": [] } }
# An empty array disables RDAP for that TLD and forces the WHOIS fallback.
# The file is read-only for the app; it is re-read automatically when it changes.
# The same mapping can also be edited from the settings page (the file wins on conflicts).
# RDAP_OVERRIDES_FILE=/config/rdap-overrides.json

# Optional: replace the bundled pages, e.g. to apply your own branding.
# PUBLIC_FILE=./admin.html
# MONITOR_PAGE_FILE=./website/monitor.html
# LOGIN_PAGE_FILE=./website/login.html
# SETTINGS_PAGE_FILE=./website/settings.html
